# ── LLM Provider ──────────────────────────────────────────────────────────────
# Use "openai", "anthropic", or "gemini"
LLM_PROVIDER=gemini

# OpenAI (required if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# Anthropic (required if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (required if LLM_PROVIDER=gemini) - FREE TIER AVAILABLE
GOOGLE_API_KEY=AIzaSy...

# ── Models ────────────────────────────────────────────────────────────────────
# OpenAI models: gpt-4o-mini, gpt-4
# Anthropic models: claude-3-haiku-20240307, claude-3-5-sonnet-20241022
# Gemini models: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# ── Vector DB ─────────────────────────────────────────────────────────────────
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=rag_demo

# ── Chunking & Retrieval ──────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
SIMILARITY_THRESHOLD=0.3

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
